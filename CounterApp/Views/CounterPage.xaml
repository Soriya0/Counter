<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterApp.Views.CounterPage"
             xmlns:models="clr-namespace:CounterApp.Models"
             x:DataType="models:Counter"
             Title="Counter">
    <VerticalStackLayout Spacing="10"
                         Margin="5">
        <VerticalStackLayout x:Name="NewCounterFields"
                             Spacing="10" >
            <Entry x:Name="NameEntry"
                   Text="{Binding Name}"
                   Placeholder="{Binding NamePlaceholder}" />

            <Entry x:Name="InitialValueEntry"
                   Text="0"
                   Keyboard="Numeric"
                   Placeholder="{Binding InitialValuePlaceholder}" />

            <Button Text="{Binding SaveButtonText}"
                    Clicked="SaveButton_Clicked" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="ExistingCounterFields"
                             IsVisible="False"
                             Spacing="10">

            <Label x:Name="NameLabel"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label x:Name="ValueLabel"
                   FontSize="40"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="4">

                <Button Grid.Column="0"
                        Text="-"
                        FontSize="30"
                        Clicked="MinusButton_Clicked" />

                <Button Grid.Column="1"
                        Text="+"
                        FontSize="30"
                        Clicked="PlusButton_Clicked" />

            </Grid>

        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>